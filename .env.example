# Hugging Face Token (required for Pyannote speaker diarization)
HF_TOKEN=hf_yourTokenHere

# -------------------------------------------------------------------------
# Optional: Hybrid Profile & LM Studio Settings
# -------------------------------------------------------------------------
# When using './run_hybrid_mac.sh', the backend uses LM Studio for local
# Apple Silicon Metal GPU acceleration and runs WhisperX natively on Mac CPU.
#
# LLM_PROVIDER=lmstudio
# LMSTUDIO_HOST=http://localhost:1234/v1
# LLAMA_MODEL=llama3:8b
# PORT=5050